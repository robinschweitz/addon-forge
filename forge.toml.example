# Copy this file to forge.toml and customize local paths.
# forge.toml is ignored by Git and must not contain account passwords.
[client]
wow_dir = "/home/YOUR_USER/Games/WoW-3.3.5a"
wine_prefix = "/home/YOUR_USER/.local/share/addon-forge/wine"
window_name = "World of Warcraft"
report_timeout = 35
