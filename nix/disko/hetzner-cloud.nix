# Destructive disk layout for the standard x86_64 Hetzner Cloud Ubuntu image.
# Must only be used after checking that the PRIMARY boot disk is /dev/sda.
# GPT + BIOS boot partition matches Hetzner's x86 legacy boot; ESP retained
# for future firmware changes. No extra attached volumes should be present.
{ ... }: {
  disko.devices.disk.main = {
    type = "disk";
    device = "/dev/sda";
    content = {
      type = "gpt";
      partitions = {
        bios = {
          size = "1M";
          type = "EF02";
          priority = 1;
        };
        ESP = {
          size = "512M";
          type = "EF00";
          content = {
            type = "filesystem";
            format = "vfat";
            mountpoint = "/boot";
            mountOptions = [ "umask=0077" ];
          };
        };
        root = {
          size = "100%";
          content = {
            type = "filesystem";
            format = "ext4";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
