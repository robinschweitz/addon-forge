diff --git a/hooks/IdleLogoutHook.cpp b/hooks/IdleLogoutHook.cpp
new file mode 100644
index 0000000..c9df818
--- /dev/null
+++ b/hooks/IdleLogoutHook.cpp
@@ -0,0 +1,16 @@
+#include "IdleLogoutHook.h"
+#include "base/DetourHelper.h"
+#include "offsets/OffsetsLogin.h"
+
+namespace Hooks::IdleLogout {
+
+using LogoutFn = int(__cdecl*)(void*);
+static LogoutFn s_original = reinterpret_cast<LogoutFn>(Offsets::Login::LOGOUT_TO_CHAR_SELECT);
+
+// Active only while the isolated test DLL is injected.
+static int __cdecl LogoutHook(void*) { return 0; }
+
+void Initialize() { Detail::attach(s_original, LogoutHook); }
+void Shutdown() { Detail::detach(s_original, LogoutHook); }
+
+}
